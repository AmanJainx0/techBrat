# ==============================================================================
# Django Core Settings
# ==============================================================================

# A secure, random secret key. Enforced in production.
# Example production key can be generated using: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-your-secret-key-for-local-development

# Toggle debug mode. In production, this MUST be set to False.
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
# In production, require your actual domain and Vercel preview domains (e.g. yourdomain.com,*.vercel.app).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated list of trusted origins for secure (HTTPS) CSRF requests.
# Required in production to prevent 403 Forbidden CSRF verification failures.
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Canonical domain name and site title configurations.
SITE_DOMAIN=localhost:8000
SITE_NAME=techBrat


# ==============================================================================
# Database Settings (PostgreSQL/Supabase only)
# ==============================================================================

# PostgreSQL database connection string. Highly recommended to use Supabase's
# connection pooler URL (aws-0-[region].pooler.supabase.com) on port 5432.
DATABASE_URL=postgresql://user:password@host:port/database


# ==============================================================================
# Production Security Overrides (Optional)
# ==============================================================================

# Enable or disable SSL redirection in production (defaults to True).
# SECURE_SSL_REDIRECT=True

# Override HSTS max-age seconds header in production (defaults to 31536000).
# SECURE_HSTS_SECONDS=31536000


# ==============================================================================
# Authentication & Third-Party OAuth Credentials
# ==============================================================================

# Google OAuth App Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret


# ==============================================================================
# AI & Third-Party API Integrations
# ==============================================================================

# AI configuration (openrouter or groq)
AI_PROVIDER=openrouter

# OpenRouter AI key and model selection
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Groq AI key and model selection
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# Adzuna Jobs API settings
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRIES=in,us,gb,au,ca,sg,de

# JSearch Jobs API settings
JSEARCH_API_KEY=your-jsearch-key
JSEARCH_API_URL=https://jsearch.p.rapidapi.com/search
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_API_AUTH_HEADER=X-RapidAPI-Key

# Jooble Jobs API settings
JOOBLE_API_KEY=your-jooble-key
JOOBLE_API_BASE_URL=https://jooble.org/api
